# =============================================================================
# MCare-AI — Environment Variables Template
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. For edge function secrets, also fill in .env.supabase and run:
#      supabase secrets set --env-file .env.supabase
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — REQUIRED (frontend)
# Get from: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# -----------------------------------------------------------------------------
# n8n / AI Webhook URLs — OPTIONAL (frontend)
# Replace with your actual n8n instance or ngrok tunnel URLs.
# If not set, the app falls back to the hardcoded dev ngrok URLs.
# -----------------------------------------------------------------------------
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/chat-id/chat
VITE_AI_ASSISTANT_WEBHOOK_URL=https://your-n8n-instance/webhook/assistant-id/chat
VITE_BLOOD_ANALYSIS_WEBHOOK_URL=https://your-n8n-instance/webhook-test/analysis-id

# Metered.ca TURN server credentials — optional fallback for WebRTC
# Get from: https://dashboard.metered.ca/
VITE_METERED_TURN_USERNAME=your_metered_username
VITE_METERED_TURN_CREDENTIAL=your_metered_credential

# =============================================================================
# Edge Function Secrets (.env.supabase)
# These are NOT read by Vite — they are deployed to Supabase via:
#   supabase secrets set --env-file .env.supabase
# =============================================================================
# GEMINI_API_KEY=your_gemini_api_key          # health-chat function
# CF_API_TOKEN=your_cloudflare_turn_token     # turn function (WebRTC TURN server)
# APP_ORIGIN=https://your-app.example.com     # CORS origin for edge functions
