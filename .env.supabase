# =============================================================================
# Supabase Edge Function Secrets
# Set these via: supabase secrets set --env-file .env.supabase
# Or individually: supabase secrets set KEY=value
# NEVER commit this file — it is listed in .gitignore.
# =============================================================================

# Gemini API key for the health-chat edge function
GEMINI_API_KEY=AIzaSyAH2Er2yJE-dCGNhqu0_YKo8CWtDC3JPJk

# Cloudflare TURN credentials for WebRTC (turn edge function)
# Get from: https://dash.cloudflare.com → Calls → TURN credentials
CF_API_TOKEN=your_cloudflare_turn_api_token

# Allowed CORS origin for edge functions in production
# Set to your deployed app URL, e.g. https://mcare.example.com
# Leave empty or omit to allow all origins (development only)
APP_ORIGIN=
